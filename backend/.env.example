PORT=5000
# Set this in your local .env or deployment environment. Never commit real credentials.
# Local PostgreSQL is the development default. Replace this with the Neon URL for cloud environments.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brandproof
# For Neon, set DATABASE_URL_UNPOOLED to the direct URL for migrations.
# The API uses DATABASE_URL (pooled URL for Neon, local URL for PostgreSQL).
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/brandproof
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=20000
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development
